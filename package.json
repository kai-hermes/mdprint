{
  "name": "mdprint",
  "displayName": "mdprint",
  "description": "Markdown to paper, one click. Right-click a .md, get a properly typeset A4 sheet. No browser, no preview, no detour.",
  "version": "0.0.1",
  "publisher": "kai-hermes",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "print",
    "pdf",
    "paper",
    "a4"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "mdprint.print",
        "title": "Print",
        "category": "mdprint"
      },
      {
        "command": "mdprint.printWithDialog",
        "title": "Print with dialog\u2026",
        "category": "mdprint"
      },
      {
        "command": "mdprint.customise",
        "title": "Customise template for this item\u2026",
        "category": "mdprint"
      },
      {
        "command": "mdprint.customiseShell",
        "title": "Customise structure for this item\u2026",
        "category": "mdprint"
      },
      {
        "command": "mdprint.choosePrinter",
        "title": "Choose printer for this document\u2026",
        "category": "mdprint"
      },
      {
        "command": "mdprint.savePdf",
        "title": "Save as PDF\u2026",
        "category": "mdprint"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "mdprint.print",
          "when": "resourceExtname == .md",
          "group": "mdprint@1"
        },
        {
          "command": "mdprint.printWithDialog",
          "when": "resourceExtname == .md",
          "group": "mdprint@2"
        },
        {
          "command": "mdprint.customise",
          "when": "resourceExtname == .md",
          "group": "mdprint@3"
        },
        {
          "command": "mdprint.customiseShell",
          "when": "resourceExtname == .md",
          "group": "mdprint@4"
        }
      ],
      "editor/title/context": [
        {
          "command": "mdprint.print",
          "when": "resourceExtname == .md",
          "group": "mdprint@1"
        },
        {
          "command": "mdprint.printWithDialog",
          "when": "resourceExtname == .md",
          "group": "mdprint@2"
        },
        {
          "command": "mdprint.customise",
          "when": "resourceExtname == .md",
          "group": "mdprint@3"
        },
        {
          "command": "mdprint.customiseShell",
          "when": "resourceExtname == .md",
          "group": "mdprint@4"
        }
      ],
      "commandPalette": [
        {
          "command": "mdprint.print",
          "when": "editorLangId == markdown"
        },
        {
          "command": "mdprint.printWithDialog",
          "when": "editorLangId == markdown"
        },
        {
          "command": "mdprint.choosePrinter",
          "when": "editorLangId == markdown"
        },
        {
          "command": "mdprint.customise",
          "when": "editorLangId == markdown"
        },
        {
          "command": "mdprint.customiseShell",
          "when": "editorLangId == markdown"
        },
        {
          "command": "mdprint.savePdf",
          "when": "editorLangId == markdown"
        }
      ]
    },
    "configuration": {
      "title": "mdprint",
      "properties": {
        "mdprint.defaultPrinter": {
          "type": "string",
          "default": "",
          "scope": "window",
          "markdownDescription": "Queue name to print to when the document doesn't name one. Leave empty to use the printer you last chose, then the system default."
        },
        "mdprint.printerSettings": {
          "type": "object",
          "default": {},
          "scope": "window",
          "markdownDescription": "Remembered print settings, keyed by printer name. Written by mdprint itself \u2014 a saved setting is a *default, never a lock*.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "duplex": {
                "type": "string",
                "enum": [
                  "one-sided",
                  "two-sided-long-edge",
                  "two-sided-short-edge"
                ]
              },
              "copies": {
                "type": "number"
              }
            }
          }
        },
        "mdprint.themeFile": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Absolute path to a workspace-wide print stylesheet, stacked on top of mdprint's built-in one. A per-item template (`<document>.mdprint.css`) wins over this."
        },
        "mdprint.theme": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Inline CSS for quick experiments, stacked after `mdprint.themeFile`. Priority: built-in \u2192 themeFile \u2192 `<document>.mdprint.css` \u2192 this \u2192 a live unsaved template from **mdprint: Customise template for this item**."
        },
        "mdprint.shellFile": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Absolute path to a workspace-wide HTML shell \u2014 the structural layout (cover page, table of contents, repositioned header/footer) a document is assembled into. A per-item shell (`<document>.mdprint.shell.html`) wins over this. Unlike CSS layers, shells do not stack: the narrowest one present and valid wins outright."
        },
        "mdprint.shell": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Inline HTML shell for quick experiments \u2014 wins over `mdprint.shellFile` and `<document>.mdprint.shell.html`, loses to a live unsaved shell from **mdprint: Customise structure for this item**. Must contain `{{mdprint:content}}` or it is refused."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run build && node --test \"out/test/**/*.test.js\"",
    "lint": "tsc -p ./ --noEmit",
    "vscode:prepublish": "npm run build",
    "embed-shim": "node scripts/embed-shim.mjs",
    "test:watch": "tsc -w -p ./ & node --test --watch \"out/test/**/*.test.js\"",
    "extract-shim": "node scripts/extract-shim.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "check-commits": "node scripts/commit-msg-hook.mjs --check-range"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kai-hermes/mdprint.git"
  },
  "bugs": {
    "url": "https://github.com/kai-hermes/mdprint/issues"
  },
  "homepage": "https://github.com/kai-hermes/mdprint#readme"
}
